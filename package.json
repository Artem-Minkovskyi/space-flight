{
  "name": "space-flight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "preview": "npm run preview --workspace=client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:determinism": "tsx --test tests/determinism.test.ts",
    "ci": "npm run typecheck && npm run test:coverage && npm run lint && npm run build && npm run test:e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-test.mjs",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.6",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^22.19.3",
    "@types/ws": "^8.18.1",
    "vitest": "^3.2.4",
    "fast-check": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@playwright/test": "^1.56.1"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
